# Local Docker Compose only. Set private credentials before starting.
POSTGRES_DB=learningen
POSTGRES_USER=learningen
POSTGRES_PASSWORD=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
FRONTEND_PORT=5173
# Local HTTP requires false. Use true behind HTTPS before any remote use.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
# Optional server-only Chat Completions provider configuration.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Image tutoring needs a model explicitly supporting image_url + JSON output.
AI_VISION_ENABLED=false
AI_VISION_MODEL=
AI_VISION_MAX_IMAGES=3
AI_VISION_MAX_IMAGE_BYTES=5242880
AI_VISION_MAX_TOTAL_IMAGE_BYTES=12582912
AI_VISION_MAX_IMAGE_PIXELS=16000000
AI_VISION_TOKENS_PER_IMAGE=4096
AI_VISION_MAX_OUTPUT_TOKENS=6000
AI_VISION_INPUT_COST_PER_MILLION=0
AI_VISION_OUTPUT_COST_PER_MILLION=0
# Keep multipart bounds consistent with nginx and the upload capability limits.
AI_MULTIPART_MAX_FILE_SIZE=5MB
AI_MULTIPART_MAX_REQUEST_SIZE=13MB
AI_DAILY_REQUESTS=30
AI_DAILY_TOKENS=50000
AI_GLOBAL_DAILY_TOKENS=100000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1000
AI_TIMEOUT_SECONDS=45
# Prices and cost limits must use the same currency. Configure actual prices.
AI_COST_TRACKING_ENABLED=false
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_DAILY_COST_LIMIT=1
AI_GLOBAL_DAILY_COST_LIMIT=5
LEARNING_PASS_SCORE=80
